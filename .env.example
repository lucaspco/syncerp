# ============================================================
# Database Configuration
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=syncerp_db
DB_USER=syncerp_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# ============================================================
# Server Configuration
# ============================================================
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# ============================================================
# Java JVM Options
# ============================================================
# Dev: -Xmx512m -Xms256m -XX:+UseG1GC
# Prod: -Xmx1024m -Xms512m -XX:+UseG1GC -XX:+UseStringDeduplication
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC

# ============================================================
# Spring Configuration
# ============================================================
SPRING_PROFILES_ACTIVE=dev

# ============================================================
# Thread Pool Configuration
# ============================================================
POOL_CORE_SIZE=5
POOL_MAX_SIZE=10
POOL_QUEUE_CAPACITY=100

# ============================================================
# Bling API Configuration
# ============================================================
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_TIMEOUT_MS=10000
WEBHOOK_RESPONSE_TIMEOUT_MS=1000

# OAuth endpoints (doc oficial: authorize = host www / token = host api)
BLING_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://api.bling.com.br/Api/v3/oauth/token

# Callback registrado nos apps Bling (campo "Link de redirecionamento")
BLING_REDIRECT_URI=https://SEU_DOMINIO/api/cnpjs/callback

# ============================================================
# Bling OAuth2 — 4 CNPJs (um app Bling por CNPJ)
# Obter no painel: Central de Extensoes > Area do Integrador
# ============================================================
BLING_CLIENT_ID_CNPJ1=YOUR_CLIENT_ID_CNPJ1
BLING_CLIENT_SECRET_CNPJ1=YOUR_CLIENT_SECRET_CNPJ1

BLING_CLIENT_ID_CNPJ2=YOUR_CLIENT_ID_CNPJ2
BLING_CLIENT_SECRET_CNPJ2=YOUR_CLIENT_SECRET_CNPJ2

BLING_CLIENT_ID_CNPJ3=YOUR_CLIENT_ID_CNPJ3
BLING_CLIENT_SECRET_CNPJ3=YOUR_CLIENT_SECRET_CNPJ3

BLING_CLIENT_ID_CNPJ4=YOUR_CLIENT_ID_CNPJ4
BLING_CLIENT_SECRET_CNPJ4=YOUR_CLIENT_SECRET_CNPJ4
